# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a Git.

# Clave de la API de Groq (https://console.groq.com/keys)
GROQ_API_KEY= 
# Modelo de Groq a usar (opcional)
GROQ_MODEL=openai/gpt-oss-120b

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/orquesta

# Puerto donde correrá el servidor Express
PORT=5000

# CORS: vacío = solo mismo origen (el frontend lo sirve este servidor).
# Varios orígenes separados por coma: http://localhost:3000,https://midominio.com
CORS_ORIGIN=

# Límite de peticiones por IP a /api/consultar y /api/fase2 (0 = sin límite)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
